{
  "name": "@mcurcio/patchbay",
  "version": "0.0.0",
  "description": "A React component library for graph-based editors and live dashboards: design tokens and themes, primitives, and React Flow graph components",
  "keywords": [
    "react",
    "components",
    "design-tokens",
    "theming",
    "react-flow",
    "graph-editor",
    "node-editor",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Matt Curcio",
  "homepage": "https://github.com/mcurcio/patchbay#readme",
  "bugs": {
    "url": "https://github.com/mcurcio/patchbay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcurcio/patchbay.git"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.15.0",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./primitives": {
      "types": "./dist/types/primitives/index.d.ts",
      "default": "./dist/primitives.js"
    },
    "./composites": {
      "types": "./dist/types/composites/index.d.ts",
      "default": "./dist/composites.js"
    },
    "./shell": {
      "types": "./dist/types/shell/index.d.ts",
      "default": "./dist/shell.js"
    },
    "./graph": {
      "types": "./dist/types/graph/index.d.ts",
      "default": "./dist/graph.js"
    },
    "./hooks": {
      "types": "./dist/types/hooks/index.d.ts",
      "default": "./dist/hooks.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project storybook",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.1.0",
    "knobly": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    },
    "knobly": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@xyflow/react": "^12.12.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "knobly": "https://github.com/mcurcio/knobly/releases/download/v1.0.0/knobly-1.0.0.tgz",
    "playwright": "1.63.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
